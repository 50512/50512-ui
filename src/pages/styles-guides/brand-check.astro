---
/**
 * Comparador entre los componentes HTML/CSS y los SVG exportados por
 * `pnpm run brand`.
 *
 * - Columna "diferencia": superpone ambos con mix-blend-mode: difference.
 *   Si el export es fiel, se ve negro.
 * - Columna "delta": compara `getBoundingClientRect()` del componente real
 *   contra las metricas de public/brand/metrics.json. Es la red de seguridad
 *   contra la desincronizacion entre styles.css y scripts/brand/variants.mjs.
 */
import "../../styles/fonts.css";
import "../../styles/styles.css";
import BannerLogo from "../../components/logo/BannerLogo.astro";
import PortraitLogo from "../../components/logo/PortraitLogo.astro";
import SquareLogo from "../../components/logo/SquareLogo.astro";
import SmallLogo from "../../components/logo/SmallLogo.astro";

const ROWS = [
  { name: "banner", Component: BannerLogo, props: {} },
  { name: "portrait", Component: PortraitLogo, props: {} },
  { name: "square", Component: SquareLogo, props: {} },
  { name: "square-status", Component: SquareLogo, props: { showStatus: true } },
  { name: "small", Component: SmallLogo, props: {} },
  { name: "small-status", Component: SmallLogo, props: { showStatus: true } },
];

const FAVICON_SIZES = [16, 32, 48, 180];
---

<!doctype html>
<html lang="es-419">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>50512.dev — verificacion de export</title>
  </head>
  <body>
    <h1 class="h1">Componente vs. SVG exportado</h1>
    <p>
      <strong>Diferencia</strong> superpone ambos en modo <code>difference</code
      >: cuanto mas negra, mas fiel. <strong>Delta</strong> compara la caja medida
      en el navegador contra <code>brand/metrics.json</code>. Regenera con
      <code>pnpm run brand</code>.
    </p>

    <table>
      <thead>
        <tr>
          <th>Variante</th><th>Componente</th><th>SVG</th>
          <th>Diferencia</th><th>Delta (px)</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map(({ name, Component, props }) => (
            <tr data-variant={name}>
              <th>{name}</th>
              <td class="dom">
                <div class="fit">
                  <Component {...props} />
                </div>
              </td>
              <td>
                <img src={`/brand/svg/${name}.svg`} alt={`${name}.svg`} />
              </td>
              <td>
                <div class="diff">
                  <div class="fit">
                    <Component {...props} />
                  </div>
                  <img src={`/brand/svg/${name}.svg`} alt="" />
                </div>
              </td>
              <td class="delta">…</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 class="h2">Favicon a tamano real</h2>
    <div class="favicons">
      {
        FAVICON_SIZES.map((s) => (
          <figure>
            <img
              src="/brand/svg/mark.svg"
              width={s}
              height={s}
              alt={`${s}px`}
            />
            <figcaption>{s}</figcaption>
          </figure>
        ))
      }
    </div>

    <script>
      /**
       * El lienzo se redondea hacia arriba a px enteros, asi que el componente
       * puede quedar hasta 1px mas pequeno que el SVG sin que sea un fallo.
       * La posicion de la marca si tiene que cuadrar al medio pixel.
       */
      const RANGE: Record<string, [number, number]> = {
        w: [-1.05, 0.05],
        h: [-1.05, 0.05],
        default: [-0.5, 0.5],
      };

      const round = (v: number) => Math.round(v * 100) / 100;

      async function check() {
        await document.fonts.ready;
        const metrics = await fetch("/brand/metrics.json").then((r) =>
          r.json(),
        );

        for (const row of document.querySelectorAll<HTMLElement>(
          "tr[data-variant]",
        )) {
          const m = metrics[row.dataset.variant!];

          // `container-type: inline-size` bloquea el ancho intrinseco del
          // .term, asi que hay que darselo explicito para poder comparar.
          for (const fit of row.querySelectorAll<HTMLElement>(".fit")) {
            fit.style.width = `${m.width}px`;
          }

          const term = row.querySelector<HTMLElement>(".dom .term")!;
          const brand = row.querySelector<HTMLElement>(".dom .brand")!;
          const t = term.getBoundingClientRect();
          const b = brand.getBoundingClientRect();

          const deltas = {
            w: t.width - m.width,
            h: t.height - m.height,
            "brand.x": b.left - t.left - m.brand.x,
            "brand.y": b.top - t.top - m.brand.y,
            "brand.w": b.width - m.brand.width,
            "brand.h": b.height - m.brand.height,
          };

          const cell = row.querySelector<HTMLElement>(".delta")!;
          cell.textContent = "";
          for (const [label, value] of Object.entries(deltas)) {
            const [min, max] = RANGE[label] ?? RANGE.default;
            const line = document.createElement("div");
            line.className = value < min || value > max ? "bad" : "ok";
            line.textContent = `${label.padEnd(8)} ${round(value) >= 0 ? "+" : ""}${round(value)}`;
            cell.append(line);
          }
        }

        document.body.dataset.checked = "true";
      }

      check();
    </script>
  </body>
</html>

<style>
  body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  table {
    border-collapse: collapse;
  }

  th,
  td {
    padding: var(--space-3);
    border: var(--border-soft);
    vertical-align: middle;
    text-align: left;
  }

  thead th,
  tbody th {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* El .term es block y ademas contiene su propio tamano inline; el ancho lo
     fija el script a partir de metrics.json. */
  .fit {
    display: inline-flex;
    flex-direction: column;
  }

  .diff {
    position: relative;
    display: inline-flex;
    background: #000;
    isolation: isolate;
  }
  .diff > img {
    position: absolute;
    inset: 0;
    mix-blend-mode: difference;
  }

  .delta {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: 1.6;
    white-space: pre;
  }
  .delta :global(.ok) {
    color: var(--success);
  }
  .delta :global(.bad) {
    color: var(--danger);
    font-weight: 700;
  }

  .favicons {
    display: flex;
    gap: var(--space-5);
    align-items: flex-end;
  }
  .favicons figure {
    margin: 0;
    text-align: center;
  }
  .favicons figcaption {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--ink-3);
    margin-top: var(--space-2);
  }
</style>
