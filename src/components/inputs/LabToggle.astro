---
import "../../styles/fonts.css";
import "../../styles/styles.css";
import type { HTMLAttributes } from "astro/types";

const LABEL_POS = {
  up: "label-up",
  down: "label-down",
  right: "label-right",
  left: "label-left",
} as const;

type LABEL_POS_TYPE = keyof typeof LABEL_POS;

interface Props extends HTMLAttributes<"input"> {
  class?: string;
  label?: string;
  label_pos?: LABEL_POS_TYPE;
  variant?: "primary" | "accent" | "dark";
}

const {
  class: className,
  label,
  label_pos = "up",
  variant = "primary",
  ...props
} = Astro.props;
const currentLabelPos = LABEL_POS[label_pos] || LABEL_POS["up"];
props.id = props.id || crypto.randomUUID();
---

<div class:list={["input-container", currentLabelPos]}>
  {
    label && (
      <label for={props.id} class:list={["label"]}>
        {label}
      </label>
    )
  }
  <input type="checkbox" {...props} />
  <label for={props.id} class:list={["switch", variant, className]}></label>
</div>

<style>
  .input-container {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;

    &.label-up {
      flex-direction: column;
    }
    &.label-down {
      flex-direction: column-reverse;
    }
    &.label-left {
      flex-direction: row;
    }
    &.label-right {
      flex-direction: row-reverse;
    }
  }

  .switch {
    width: var(--space-6);
    height: var(--space-4);
    border: 1px solid var(--ink);
    background: var(--surface-2);
    position: relative;
    cursor: pointer;
    transition: background var(--dur-micro) var(--easing-clinical);
  }

  .switch::after {
    content: "";
    position: absolute;
    top: 1px;
    left: 1px;
    width: var(--space-3);
    height: var(--space-3);
    background: var(--ink);
    transition:
      transform var(--dur-micro) var(--easing-clinical),
      background var(--dur-micro) var(--easing-clinical);
  }

  input:checked + .switch::after {
    transform: translateX(var(--space-4));
  }

  input:checked + .switch {
    &.primary {
      background: var(--primary);
    }
    &.accent {
      background: var(--accent);
    }
    &.dark {
      background: var(--ink);
    }

    &.primary::after,
    &.dark::after {
      background: var(--fg-on-blue);
    }
  }

  input {
    appearance: none;
    display: none;
  }
  .input-container:has(input:disabled) label {
    pointer-events: none;
  }
  input:disabled + .switch,
  input:checked:disabled + .switch {
    background-color: var(--surface-2);
    border-color: var(--ink-3);
    &::after {
      background: var(--ink-3);
    }
  }
</style>
