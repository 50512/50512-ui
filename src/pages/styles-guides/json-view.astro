---
import StylePages from "../../layouts/StylePages.astro";
import { JsonView } from "../../components/json";
---

<StylePages title="Visor JSON">
  <div class="wrap">
    <h1>Visor JSON</h1>
    <p>
      Visor de JSON colapsable, con colores por tipo y match de los brackets
    </p>
    <JsonView
      value={{
        colores: ["string", 10, true, null],
        anidados: {
          anida2: {
            any2: {
              array: [
                "soporta",
                "multiple",
                {
                  profundidad: {
                    long_string: crypto.randomUUID() + crypto.randomUUID(),
                  },
                },
                {},
              ],
            },
          },
        },
      }}
    />

    <p><strong>Vista default:</strong></p>
    <JsonView />
  </div>
</StylePages>
<style>
  .wrap {
    display: flex;
    flex-direction: column;

    padding: var(--space-3);
    background: var(--surface-1);
  }
</style>
