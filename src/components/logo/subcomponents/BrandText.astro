---
import "../../../styles/fonts.css";
import "../../../styles/styles.css";

const VARIANTS = {
  banner: ["display-lg"],
  portrait: ["display-lg", "portrait-brand"],
  square: ["display", "square-brand"],
  small: ["display", "square-brand"],
  wordmark: ["h2", "wordmark"],
} as const;

interface Props {
  variant?: keyof typeof VARIANTS;
  class?: string;
}

const { variant = "banner", class: className } = Astro.props;

const currentVariant = VARIANTS[variant];
---

<div class:list={["brand", currentVariant, className]}>
  <span class="blue">5</span>
  <span class="orange">0</span>
  <span class="blue">5</span>
  <span class="orange">12</span>
  <span class="orange">.</span>
  <span class="ink">dev</span>
</div>

<style>
  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    margin: 0;
    word-break: keep-all;
  }

  .portrait-brand {
    font-size: clamp(var(--fs-h1), 14cqw, var(--fs-display-xl));
    display: block;
    margin: var(--space-1) 0;
  }

  .square-brand {
    text-align: center;
  }

  .wordmark > .ink {
    color: var(--ink-3);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
  }
</style>
