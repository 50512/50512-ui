---
import StylePages from "../../layouts/StylePages.astro";
import { LabTextInput, LabButton, LabCheckbox } from "../../components/inputs";
---

<StylePages title="Entradas">
  <div class="wrap">
    <h1>Colección de distintos <i>inputs</i></h1>
    <p>Estos serán los tipos inputs a usar en todo el proyecto.</p>

    <div class="container">
      <h2>Botones</h2>
      <LabButton variant="primary">Primary</LabButton>
      <LabButton variant="accent">Accent</LabButton>
      <LabButton variant="ghost">Ghost</LabButton>
      <LabButton disabled>Disabled</LabButton>
    </div>
    <div class="container">
      <h2>Entrada de texto</h2>
      <LabTextInput label="Con valor" value="Test value" />
      <LabTextInput label="Con placeholder" placeholder="test holder" />
      <LabTextInput label="Sin placeholder" />
      <LabTextInput value="Sin label" />
      <LabTextInput placeholder="Sin label" />
      <LabTextInput />
      <LabTextInput value="Deshabilitado" disabled />
      <div class="container">
        <h3>Otros tipos de entrada de texto</h3>
        <LabTextInput
          label="Correo"
          placeholder="email@example.com"
          type="email"
        />
        <LabTextInput label="Fecha" type="date" />
        <LabTextInput label="Mes" type="month" />
        <LabTextInput label="Semana" type="week" />
        <LabTextInput label="Número" type="number" value="50512" />
        <LabTextInput
          label="Contraseña"
          type="password"
          placeholder="Contraseña"
        />
      </div>
    </div>
    <div class="container">
      <h2>Cajas de verificación y sus variantes</h2>
      <div class="container checkbox">
        <h3>Checkboxes con/sin label</h3>
        <LabCheckbox label="Label up" label_pos="up" />
        <LabCheckbox label="Label right" label_pos="right" variant="light" />
        <LabCheckbox label="Label left" label_pos="left" variant="dark" />
        <LabCheckbox label="Label down" label_pos="down" variant="accent" />
        <LabCheckbox variant="primary" />
        <LabCheckbox variant="primary" disabled checked />
        <LabCheckbox variant="primary" disabled />
        <LabCheckbox variant="light" />
        <LabCheckbox variant="light" disabled checked />
        <LabCheckbox variant="light" disabled />
        <LabCheckbox variant="dark" />
        <LabCheckbox variant="dark" disabled checked />
        <LabCheckbox variant="dark" disabled />
        <LabCheckbox variant="accent" />
        <LabCheckbox variant="accent" disabled checked />
        <LabCheckbox variant="accent" disabled />
      </div>
    </div>
  </div>
</StylePages>

<style>
  .container {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);

    padding-bottom: var(--space-3);
    flex-wrap: wrap;
    align-items: flex-end;
  }
  .container.checkbox {
    align-items: center;
  }
  .wrap {
    display: flex;
    flex-direction: column;

    padding: var(--space-3);
    background: var(--surface-1);
  }
  h2,
  h3 {
    width: 100%;
  }
</style>
