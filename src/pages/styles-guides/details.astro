---
import StylePages from "../../layouts/StylePages.astro";
import LabDetails from "../../components/LabDetails.astro";
---

<StylePages title="Desplegable">
  <div class="wrap">
    <h1>Desplegable</h1>
    <p>
      Componente desplegable. Wrapper de <span class="code">{"<details>"}</span>
    </p>
    <LabDetails title="Título del detalle (summary)">
      <p>
        Contenido del detalle. Reduce el <code>padding-bottom</code> de nivel 3 a
        nivel 2 cuando el detalle esta abierto.
      </p>
    </LabDetails>
    <LabDetails title="Múltiples detalles">
      <p>El borde inferior permite distinguir donde acaba el detalle.</p>
    </LabDetails>
    <LabDetails title="Marcador personalizado">
      <p>
        Se opta por usar <code>+</code> y <code>-</code> como marcadores de abierto
        y cerrado.
      </p>
    </LabDetails>
  </div>
</StylePages>
<style>
  .wrap {
    display: flex;
    flex-direction: column;

    padding: var(--space-3);
    background: var(--surface-1);
  }
</style>
