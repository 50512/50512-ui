---
import "../../styles/styles.css";
import "../../styles/fonts.css";
import { BrandText } from "../logo";

interface Props {
  baseURL?: string;
}

const { baseURL = "/" } = Astro.props;
---

<header>
  <a href={baseURL}>
    <BrandText variant="wordmark" />
  </a>
  <nav class="desktop">
    <slot />
  </nav>
  <details class="mobile" id="nav-menu">
    <summary aria-label="Abrir menú">☰</summary>
    <nav class="menu">
      <slot />
    </nav>
  </details>
</header>

<script>
  document.addEventListener("click", (e) => {
    const menu = document.getElementById(
      "nav-menu",
    ) as HTMLDetailsElement | null;
    if (!menu) return;

    // Si el menú no contiene el nodo objetivo
    if (menu.open && !menu.contains(e.target as Node)) {
      menu.open = false;
    }
  });
</script>

<style>
  header {
    display: flex;
    flex-direction: row;
    align-items: center;

    background: var(--surface-1);
    padding: 0 var(--space-5);
    height: var(--tile);
    width: 100%;
    border-bottom: var(--border-soft);
  }

  a {
    text-decoration: none;
  }

  nav.desktop {
    display: flex;
    flex-direction: row;
    gap: var(--space-1);
    margin-left: var(--space-5);
  }

  details.mobile {
    display: none;
    margin-left: auto;
    position: relative;
  }

  summary {
    list-style: none;
    cursor: pointer;
    font-size: 1.5rem;
    padding: var(--space-2);
  }
  summary::-webkit-details-marker {
    display: none;
  }

  details.mobile .menu {
    position: absolute;
    top: 100%;
    right: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border: var(--border-soft);
    min-width: 170px;
    z-index: 10;
    box-shadow: var(--shadow-label-gray);
  }

  @media (max-width: 1000px) {
    nav.desktop {
      display: none;
    }
    details.mobile {
      display: block;
    }
  }
</style>
