---
import "../../styles/fonts.css";
import "../../styles/styles.css";

const configVariants = {
  operative: {
    dot_color: "green",
    pill_text: "OPERATIVO",
  },
  trial: {
    dot_color: "orange",
    pill_text: "EN PROGRESO",
  },
  offline: {
    dot_color: "red",
    pill_text: "NO DISPONIBLE",
  },
} as const;

type ConfigVariantKeys = keyof typeof configVariants;

interface Props {
  variant?: ConfigVariantKeys;
  noUppercase?: boolean;
  label?: string;
  class?: string;
}

const {
  variant = "operative",
  noUppercase = false,
  label,
  class: className,
} = Astro.props;

const currentConfigVariant = configVariants[variant];
const dotColor = currentConfigVariant.dot_color;
const labelToShow = label || currentConfigVariant.pill_text;
---

<span
  class:list={["pills", "micro", className]}
  style={noUppercase && "text-transform: none; letter-spacing: unset;"}
>
  <span class:list={["dot", dotColor]}></span>
  {labelToShow}
</span>

<style>
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .green {
    background: var(--success);
  }

  .orange {
    background: var(--brand-orange-500);
    animation: blink 1s steps(2) infinite;
  }

  .red {
    background: var(--danger);
  }
</style>
