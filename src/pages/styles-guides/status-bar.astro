---
import StylePages from "../../layouts/StylePages.astro";
import StatusBar from "../../components/StatusBar.astro";
import { STATUS_COMPONENTS_CONFIG, type StatusKeysType } from "../../utils/statusPagesConfig";
---
<StylePages title="Barra de estado">
  <h1>Barra de estado</h1>
  <h2>Posibles estados:</h2>
  <div class="status-container">
    <h3>Multi tags</h3>
    <StatusBar>
      <span>tag test</span>
      <span>new tag</span>
      <span>updated on: yesterday</span>
    </StatusBar>
    {
      Object.keys(STATUS_COMPONENTS_CONFIG).map((config) => (
        <div>
          <h3>{config}</h3>
          <StatusBar variant={config as StatusKeysType} />
        </div>
      ))
    }
  </div>
</StylePages>

<style>
  .status-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
  }
</style>