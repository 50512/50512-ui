---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBar from "../../components/StatusBar.astro";
import { STATUS_COMPONENTS_CONFIG, type StatusKeysType } from "../../utils/statusPagesConfig";
---
<BaseLayout title="Barra de estado">
  <h1>Barra de estado</h1>
  <h2>Posibles estados:</h2>
  <div class="status-container">
    {
      Object.keys(STATUS_COMPONENTS_CONFIG).map((config) => (
        <div>
          <h3>{config}</h3>
          <StatusBar variant={config as StatusKeysType} />
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .status-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>