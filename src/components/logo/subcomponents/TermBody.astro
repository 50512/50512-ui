---
import "../../../styles/fonts.css";
import "../../../styles/styles.css";
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["term-body", className]}>
  <slot />
</div>

<style>
  .term-body {
    display: flex;
    flex-direction: row;
    flex: 1;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }

  .portrait-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: unset;
    gap: unset;
  }

  .square-body {
    justify-content: center;
    padding: clamp(var(--space-3), 4cqw, var(--space-5));
  }
</style>
