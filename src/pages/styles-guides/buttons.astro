---
import StylePages from "../../layouts/StylePages.astro"
import LabButton from "../../components/LabButton.astro"
---
<StylePages title="Botones">
  <div class="title">
    <h1>Tipos de botones y sus estilos</h1>
    <p>Estos serán los tipos base de botones a usar en todo el proyecto.</p>
  </div>
  <div class="container">
    <LabButton variant="primary">Primary</LabButton>
    <LabButton variant="accent">Accent</LabButton>
    <LabButton variant="ghost">Ghost</LabButton>
    <LabButton disabled>Disabled</LabButton>
  </div>
</StylePages>

<style>
  div {
    width: 100%;
    padding: var(--space-3) var(--space-5);
  }
  .container {
    background-color: var(--surface-1);
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
  }
</style>