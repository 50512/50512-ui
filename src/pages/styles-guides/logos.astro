---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BannerLogo, PortraitLogo, SquareLogo, SmallLogo } from '../../components/logo';
---
<BaseLayout title='Logos HTML'>
  <h1>Logos oficiales (HTML)</h1>
  <p>Conjunto oficial de logos en <span class="code">HTML/CSS</span>.
    De estos se generan los rasterizados en <a href="../brand-check/">/brand-check</a></p>
  <div class="container">
    <BannerLogo />
    <PortraitLogo />
    <div class="icon-row">
      <SquareLogo />
      <SquareLogo showStatus/>
      <SmallLogo />
      <SmallLogo showStatus/>
    </div>
  </div>
</BaseLayout>

<style>
  .icon-row {
    display: flex;
    flex-direction: row;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
