---
import StylePages from "../../layouts/StylePages.astro";
import LabButton from "../../components/LabButton.astro";
---

<StylePages title="Entradas">
  <h1>Colección de distintos <i>inputs</i></h1>
  <p>Estos serán los tipos inputs a usar en todo el proyecto.</p>

  <div class="wrap">
    <h2>Botones</h2>
    <div class="container">
      <LabButton variant="primary">Primary</LabButton>
      <LabButton variant="accent">Accent</LabButton>
      <LabButton variant="ghost">Ghost</LabButton>
      <LabButton disabled>Disabled</LabButton>
    </div>
  </div>
</StylePages>

<style>
  .container {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
  }
  .wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);

    padding: var(--space-3);
    background: var(--surface-1);
  }
</style>
