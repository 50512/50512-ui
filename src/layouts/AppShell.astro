---
import "../styles/fonts.css";
import "../styles/styles.css";
import { ClientRouter } from "astro:transitions";
import StatusBar from "../components/StatusBar.astro";
import Footer from "../components/Footer.astro";
import type { AppShellProps } from "./types";

type Props = AppShellProps;

const {
  title,
  status = "operative",
  barLabel,
  lang = "es-419",
  showStatusBar = true,
  footerMarginAuto = true,
} = Astro.props;
---

<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <title>{title}</title>

    <ClientRouter />
  </head>
  <body class="page">
    {
      showStatusBar && (
        <StatusBar
          transition:persist="status-bar"
          variant={status}
          label={barLabel}
        />
      )
    }
    <slot name="navbar" />
    <slot />
    <Footer {footerMarginAuto}>
      <slot name="footer">
        Powered by <a href="https://50512.dev">50512</a>
      </slot>
    </Footer>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
</style>
